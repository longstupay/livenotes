{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "local shell windows: main dashboard, spike console, diagnostics, live subtitle views",
  "windows": ["main", "rooms", "diag", "live-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
